{
  "name": "bterminal",
  "private": true,
  "version": "1.1.1",
  "description": "A desktop market research app for tracking a portfolio, researching stocks and indices, and following news, economic indicators, prediction markets, and congressional disclosures.",
  "author": "Alberto Cardaci",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node scripts/run-desktop-dev.mjs",
    "fix:electron-mac": "node scripts/fix-electron-mac.mjs",
    "build": "tsc && vite build",
    "build:icon": "node scripts/build-desktop-assets.mjs",
    "build:desktop": "npm run build && npm run build:icon && node scripts/package-desktop.mjs dir",
    "dist:desktop": "npm run build && npm run build:icon && node scripts/package-desktop.mjs dist",
    "dist:desktop:win": "npm run build && npm run build:icon && electron-builder --win nsis portable --x64 --arm64",
    "preview": "vite preview",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:sec-edgar": "node scripts/check-sec-edgar.mjs",
    "check:bls": "node scripts/check-bls.mjs",
    "check:macro-sources": "node scripts/check-macro-sources.mjs",
    "check:opportunities-quality": "node scripts/check-opportunities-quality.mjs",
    "check:early-signals": "node scripts/check-early-signals.mjs",
    "verify:desktop": "node scripts/verify-macos-build.mjs",
    "check:portfolio": "node scripts/check-portfolio.mjs",
    "check:market-display": "node scripts/check-market-display.mjs",
    "check:public-data": "node scripts/check-public-data.mjs",
    "check:news-coverage": "node scripts/check-news-coverage.mjs",
    "check:startup": "node scripts/check-startup.mjs",
    "check:congress": "node scripts/check-congress.mjs",
    "check:companion": "node scripts/check-companion-server.mjs",
    "check:workspace-headings": "electron scripts/check-workspace-headings.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.9",
    "@vitejs/plugin-react": "^4.2.1",
    "date-fns": "^3.2.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "hyparquet": "^1.33.2",
    "lightweight-charts": "^4.1.3",
    "lucide-react": "^0.314.0",
    "markdown-to-jsx": "^9.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.10.4",
    "unpdf": "^1.9.1",
    "vite": "^5.0.12",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.13.2",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.17",
    "electron": "^35.1.5",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2"
  },
  "build": {
    "appId": "com.alcardaci.charlie",
    "productName": "Charlie",
    "executableName": "Charlie",
    "npmRebuild": false,
    "asar": false,
    "beforePack": "scripts/bundle-desktop-config.cjs",
    "afterSign": "scripts/notarize-macos.cjs",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build-assets/Charlie.icns",
      "artifactName": "Charlie-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "win": {
      "icon": "public/charlie-icon/1024x1024.png",
      "artifactName": "Charlie-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Charlie-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Charlie-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "public/charlie-icon",
      "artifactName": "Charlie-${version}-${arch}.${ext}",
      "category": "Office;Finance;",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build-assets/desktop-config.mjs",
      "package.json"
    ]
  }
}
